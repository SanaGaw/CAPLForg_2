# === CAPL Pipeline V2.2 Environment Configuration ===
# Configured for Generative Engine API

# Logging
LOG_LEVEL=INFO
LOG_VERBOSE=false
LOG_FILE=logs/pipeline.log

# LLM Provider Configuration (Generative Engine via OpenAI-compatible endpoint)
LLM_PRIMARY_PROVIDER=openai
LLM_PRIMARY_MODEL=amazon.nova-lite-v1:0
LLM_SECONDARY_PROVIDER=openai
LLM_SECONDARY_MODEL=us.anthropic.claude-3-5-haiku-20241022-v1:0
LLM_TERTIARY_PROVIDER=openai
LLM_TERTIARY_MODEL=amazon.nova-micro-v1:0
LLM_LIGHTWEIGHT_MODEL=amazon.nova-micro-v1:0
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL=3600

# Generative Engine Configuration (OpenAI-compatible endpoint)
OPENAI_API_BASE=https://openai.generative.engine.capgemini.com/v1
OPENAI_API_KEY=yKIHuIVGgX8SlhG6Rqfx29Ptn1oSfb2c4umgVAgB

# Azure OpenAI (Disabled - using Generative Engine instead)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01

# AWS Bedrock (Disabled - using Generative Engine instead)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Vertex AI (Disabled - using Generative Engine instead)
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Local Fallback (compliance/offline mode)
OLLAMA_BASE_URL=http://localhost:11434

# STO Processing
STO_ENRICH_AUTO=true
STO_DROP_THRESHOLD=0.20
STO_SPEC_FORMAT=docx

# CANoe Integration
CANOE_PATH=
CANOE_VERSION=
CANOE_CLI_TIMEOUT=60

# Performance
MAX_PARALLEL_TASKS=4
MAX_MEMORY_MB=2048
CACHE_SIGNAL_RESOLUTION=true

# Compliance
COMPLIANCE_MODE=false
AUDIT_RETENTION_DAYS=90
TRACEABILITY_FORMAT=jsonld

# Config Builder
CONFIG_BUILDER_MAX_ITERATIONS=100
CONFIG_BUILDER_MAX_RETRIES_PER_GAP=3
CONFIG_BUILDER_OFFLINE_FALLBACK=true

# Pattern Analysis
PATTERN_MIN_FREQUENCY=2

# Feature Flags
ENABLE_HELPER_SUGGESTIONS=true
ENABLE_TEMPLATE_BROWSER=true
ENABLE_INCREMENTAL_GENERATION=true