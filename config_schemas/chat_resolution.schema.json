{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChatResolution",
  "type": "object",
  "required": ["version", "proposed_resolution"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "proposed_resolution": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": { "enum": ["add_alias", "add_constant", "apply_template", "apply_helper", "skip", "defer"] },
        "target": { "type": "string" },
        "value_or_template": { "type": "string" },
        "parameters": { "type": "object" },
        "apply_globally": { "type": "boolean", "default": false },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "validation_checks": {
      "type": "object",
      "properties": {
        "signal_exists": { "type": "boolean" },
        "type_match": { "type": "boolean" },
        "range_valid": { "type": "boolean" },
        "bus_compatible": { "type": "boolean" }
      }
    },
    "requires_approval": { "type": "boolean" },
    "explanation": { "type": "string" }
  }
}
