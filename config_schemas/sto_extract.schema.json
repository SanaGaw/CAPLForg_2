{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StoExtract",
  "type": "object",
  "required": ["version", "signals"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "source_file": { "type": "string" },
    "extracted_at": { "type": "string", "format": "date-time" },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "sto_table_type": { "enum": ["IN", "OUT", "Cal", "Proxi", "DTC"] },
          "ecu": { "type": "string" },
          "value": {},
          "unit": { "type": "string" },
          "description": { "type": "string" },
          "table_row": { "type": "integer" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "inconsistency_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "signal": { "type": "string" },
          "conflict_type": { "type": "string" },
          "details": { "type": "string" }
        }
      }
    }
  }
}
