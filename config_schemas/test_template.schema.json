{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TestTemplate",
  "type": "object",
  "required": ["version", "name", "template"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "name": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "description": { "type": "string" },
    "category": { "type": "string" },
    "template": { "type": "string" },
    "required_signals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "optional_signals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "default": {},
          "description": { "type": "string" }
        }
      }
    }
  }
}
