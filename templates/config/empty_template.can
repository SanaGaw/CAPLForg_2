/*!
 * Empty Template
 *
 * Base template for custom test case generation.
 * Copy and modify as needed.
 *
 * Generated by CAPL Pipeline V2.2
 */

#include <helpers.cin>

/*! Test Case: {{ test_case_id }}
 *  Description: {{ description }}
 */

void Test_{{ test_case_id | replace("-", "_") | replace(".", "_") }}(void) {
    {% for step in test_steps %}
    testStep("{{ step.step_id }}", "{{ step.action }}");
    {% if step.custom_code %}
    {{ step.custom_code }}
    {% endif %}
    {% endfor %}
}
