#include <helpers.cin>
#include "constants.cin"

/*! Test Case: {{ test_case_id }}
 *  Description: {{ description }}
 */

void Test_{{ test_case_id | replace("-", "_") | replace(".", "_") }}(void) {
    {% for step in test_steps %}
    testStep("{{ step.step_id }}", "{{ step.action }}");
    {% if step.signal %}
    {% if step.action_type == 'transfer' %}
    // Transfer signal between CAN networks
    ${{ step.signal }} = {{ step.value | default('1') }};
    {% endif %}
    {% endif %}
    {% endfor %}
}
