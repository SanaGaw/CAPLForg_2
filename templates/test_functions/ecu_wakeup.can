/*!
 * Test Function: ECUWakeUp
 *
 * Performs ECU wake-up sequence by sending wake-up signals
 * to specified ECUs on the CAN bus.
 *
 * Parameters:
 *   - timeout: Wait time between ECU wake-ups (ms)
 *
 * Generated by CAPL Pipeline V2.2
 */

void ECUWakeUp(int timeout) {
    {% for ecu in ecus %}
    ${{ ecu.signal }} = 1;
    putValue({{ ecu.env_var }}, 1);
    testWaitForTimeout(timeout);
    {% endfor %}
}

/*! Example usage:
 *
 * void TestWakeUpSequence() {
 *     ECUWakeUp(100);  // 100ms between each ECU
 * }
 */
