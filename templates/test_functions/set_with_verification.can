/*!
 * Test Function: SetSignalWithVerification
 *
 * Sets a signal value and verifies the response.
 *
 * Parameters:
 *   - signal: Signal to set
 *   - value: Value to set
 *   - expectedResponse: Expected response value
 *   - responseSignal: Signal to monitor for response
 *   - timeout: Maximum wait time in ms
 *
 * Generated by CAPL Pipeline V2.2
 */

void SetSignalWithVerification(
    int signal,
    int value,
    int expectedResponse,
    int responseSignal,
    int timeout
) {
    putValue(signal, value);
    if (!WaitForSignalState(responseSignal, expectedResponse, timeout)) {
        TestReportAddFailure("Signal response verification failed");
    }
}

/*! Example usage:
 *
 * void TestSetDoorLockWithVerification() {
 *     SetSignalWithVerification(
 *         EnvDoorLock_FL, 1,
 *         1, DoorLock_FL_Status,
 *         5000
 *     );
 * }
 */
