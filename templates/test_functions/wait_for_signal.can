/*!
 * Test Function: WaitForSignalState
 *
 * Waits for a signal to reach a specific state with timeout.
 *
 * Parameters:
 *   - signal: Signal to monitor
 *   - expectedValue: Value to wait for
 *   - timeout: Maximum wait time in ms
 *
 * Generated by CAPL Pipeline V2.2
 */

int WaitForSignalState(int signal, int expectedValue, int timeout) {
    long startTime;
    long currentTime;

    startTime = testGetTickCount();
    while (1) {
        if (signal == expectedValue) {
            return 1;  // Success
        }
        currentTime = testGetTickCount();
        if (currentTime - startTime > timeout) {
            return 0;  // Timeout
        }
        testWaitForTimeout(10);
    }
}

/*! Example usage:
 *
 * void TestDoorLockResponse() {
 *     putValue(EnvDoorLock_FL, 1);
 *     if (WaitForSignalState(DoorLock_FL_Status, 1, 5000)) {
 *         testStep("PASS", "Door lock responded within timeout");
 *     } else {
 *         TestReportAddFailure("Door lock did not respond in time");
 *     }
 * }
